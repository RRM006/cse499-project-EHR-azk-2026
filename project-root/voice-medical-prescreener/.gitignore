# --- Secrets (NEVER commit) ---
.env
*.env
# S44: ANY backup or variant of a .env is a full copy of every credential in it.
# `*.env` does not match `.env.20260819.bak`, and during S44 a tooling backup with
# that exact shape landed in the working tree unignored. It never reached git and was
# deleted, but the pattern that would have caught it belongs here rather than in a
# memory of the incident.
.env.*
*.env.*
# the example template IS committed (key names only)
!*.env.example
!.env.example

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Local data / DB (synthetic or consented samples only; not committed) ---
*.db
# pre-migration DB backups (e.g. prescreener.db.pre-0003.bak)
# NOTE: an inline `#` is NOT a comment in .gitignore - it is part of the pattern.
# Both of these rules were silently matching nothing until S41 found it.
*.db.*.bak
*.sqlite
*.sqlite3
data/
audio/

# --- Downloaded ML models (Phase 1+) ---
models/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.vscode/
.idea/
