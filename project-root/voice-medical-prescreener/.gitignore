# --- Secrets (NEVER commit) ---
.env
*.env
# the example template IS committed (key names only)
!*.env.example

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Local data / DB (synthetic or consented samples only; not committed) ---
*.db
# pre-migration DB backups (e.g. prescreener.db.pre-0003.bak)
# NOTE: an inline `#` is NOT a comment in .gitignore - it is part of the pattern.
# Both of these rules were silently matching nothing until S41 found it.
*.db.*.bak
*.sqlite
*.sqlite3
data/
audio/

# --- Downloaded ML models (Phase 1+) ---
models/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.vscode/
.idea/
