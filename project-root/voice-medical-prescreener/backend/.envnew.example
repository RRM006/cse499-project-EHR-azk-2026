# ============================================================================
#  backend/.envnew.example  —  EXAMPLE configuration
#  Copy this to .env and fill in the values marked below.
# ============================================================================

# --- Active correction provider (swappable: gemini | groq | openrouter) ---
CORRECTION_PROVIDER=gemini

# Which model to use for correction. Default is the moving "latest" alias.
# To pin a specific version, comment the line below and uncomment one example.
CORRECTION_MODEL=gemini-flash-latest
# CORRECTION_MODEL=gemini-2.5-flash        # pinned Flash (stable, recommended for reproducibility)
# CORRECTION_MODEL=gemini-2.5-flash-lite   # cheaper/faster, higher free RPM
# CORRECTION_MODEL=gemini-2.0-flash        # older generation, if you need it

# --- Gemini (OpenAI-compatible endpoint) ---
# >>> FILL THIS IN <<< : regenerate your key at https://aistudio.google.com/apikey
#     then replace the placeholder below with the new key. Do NOT add quotes.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Groq (live-loop bucket: M6 gaps + M7 follow-up, ADR-0026) ---
GROQ_API_KEY=

# --- OpenRouter (universal :free fallback, ADR-0026) ---
OPENROUTER_API_KEY=

# NOTE: Module 1 uses the browser Web Speech API for speech-to-text (client-side),
# so there is no STT provider configuration here.
