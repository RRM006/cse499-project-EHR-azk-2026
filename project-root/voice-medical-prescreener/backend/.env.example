# Copy this file to  backend/.env  and fill in your real key.
# backend/.env is gitignored and must NEVER be committed.
# Get a free key at https://aistudio.google.com/apikey

# --- Active correction provider (swappable: gemini | groq | openrouter) ---
CORRECTION_PROVIDER=gemini

# Which model to use for correction. Default is the moving "latest" alias.
# To pin a specific version instead, comment the line below and uncomment one example.
CORRECTION_MODEL=gemini-flash-latest
# CORRECTION_MODEL=gemini-2.5-flash        # pinned Flash (stable, recommended for reproducibility)
# CORRECTION_MODEL=gemini-2.5-flash-lite   # cheaper/faster, higher free RPM
# CORRECTION_MODEL=gemini-2.0-flash        # older generation, if you need it

# --- Gemini (OpenAI-compatible endpoint) ---
# Paste your real key here ONLY in backend/.env (this .example file stays blank).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Correction fallback providers (optional; leave blank in Module 1) ---
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Extra FREE fallback buckets (optional; blank = skipped automatically) ---
# When a provider hits its free rate/daily limit it goes on a short cooldown and
# the pipeline switches to the next configured free bucket automatically
# (order: assigned bucket -> Groq -> Cerebras -> Mistral -> OpenRouter).
# Cerebras: free ~1M tokens/day, very fast. Key: https://cloud.cerebras.ai
# CEREBRAS_API_KEY=
# Mistral "Experiment" tier: ~1B tokens/month BUT trains on your inputs —
# rule #4: synthetic/consented data ONLY. Key: https://console.mistral.ai
# MISTRAL_API_KEY=

# --- Speech-to-text source ---
# Module 1 uses the browser Web Speech API (client-side), so this is just a label
# today. It is a seam for future swappable STT engines (e.g. faster-whisper).
STT_PROVIDER=browser_webspeech

# --- Patient voice loop (faculty Requirement 3 + 3b, ADR-0047 + ADR-0048) ---
# Voice is the PRIMARY patient interaction; typing is always available as the
# fallback. VOICE_LOOP picks the kiosk's turn-taking behaviour:
#   auto   = voice-first (default): the mic opens itself after the question is
#            spoken, and a visible 3-2-1 countdown submits the answer.
#   manual = the original tap-to-talk path — kept for noisy rooms and A/B testing.
# An unrecognized value falls back to "auto" (a .env typo never breaks startup).
VOICE_LOOP=auto
# Timings in milliseconds, served to the kiosk by GET /api/config so a clinic can
# tune them for elderly patients WITHOUT editing JavaScript. Defaults shown.
# ⚠ Read at startup only — changing these needs a server RESTART.
# The 3-2-1 countdown IS the silence window, and it is a CONFIRMATION window:
# any resumed speech cancels it. Raise it for slower speakers.
# VOICE_COUNTDOWN_MS=3000
# Pause after the question finishes speaking before the mic may open, so the AI's
# own voice can never be transcribed into the patient's record.
# VOICE_TTS_GUARD_MS=400
# Total silence before the question is repeated once, then typing is offered.
# VOICE_NO_SPEECH_MS=10000
# Hard cap on one answer before whatever was captured is submitted.
# VOICE_MAX_ANSWER_MS=120000
# S34 (ADR-0055): read every SPOKEN answer back and wait for the patient to accept or
# repeat it before it is stored. Costs one tap per spoken turn; set false for the
# S25-era hands-free flow. Typed answers are never gated.
# VOICE_ANSWER_CONFIRM=true
# S34 (ADR-0055): the review screen submits itself after this long. Any manual action
# cancels it, and it never runs while required information is still missing. 0 = off.
# VOICE_REVIEW_TIMEOUT_MS=60000
# S35 (ADR-0056): how long the spoken phone number is shown and read back before it is
# accepted on its own. The number is still shown large and read digit by digit — this is
# the window, not a bypass. 0 restores ADR-0053's tap-required rule exactly.
# VOICE_PHONE_CONFIRM_MS=10000

# --- Bangla TTS fallback (ADR-0049, provider chosen in ADR-0050) ---
# Windows ships NO Bengali voice at all, so on Windows the browser can never speak
# Bangla however the clinic is configured. TTS_PROVIDER names the SERVER-SIDE voice
# used only when the browser has no bn* voice of its own (an installed browser voice
# always wins — that is the Arch path, ADR-0040):
#   edge    = Microsoft neural bn-BD via edge-tts (DEFAULT). Natural-sounding, free,
#             no API key. Needs internet.
#             ⚠ PRIVACY: sends the question text to Microsoft. M7 questions are DERIVED
#             from what the patient said, so this exports patient-derived content to a
#             third party. Accepted deliberately in ADR-0050 for a research prototype on
#             synthetic data (the Web Speech API already sends the patient's AUDIO to
#             Google). Use espeak below if you need that to stay on the machine.
#   espeak  = local espeak-ng. Offline, no key, no question text ever leaves the
#             machine. ROBOTIC — rejected on quality in the S29 live listen, kept as the
#             private/offline option and as the automatic fallback.
#             Install: winget install eSpeak-NG.eSpeak-NG  /  pacman -S espeak-ng
#   browser = no server voice at all; the exact pre-ADR-0049 behaviour.
# An unrecognized value falls back to "browser" (a typo never breaks startup).
# ⚠ Read at startup only — changing these needs a server RESTART.
TTS_PROVIDER=edge
# When the provider above fails (no internet, service down), render with local espeak-ng
# instead of returning nothing: a robotic question beats a silent kiosk. Set false to
# keep ADR-0049's original behaviour, where any failure is a bare 503 and the patient
# just reads the question on screen.
# TTS_LOCAL_FALLBACK=true
# --- edge provider ---
# bn-BD-NabanitaNeural (female) / bn-BD-PradeepNeural (male) are the two BANGLADESHI
# voices. bn-IN-BashkarNeural / bn-IN-TanishaaNeural exist but are Indian Bengali —
# a noticeably different accent for a Dhaka clinic.
# TTS_EDGE_VOICE_BN=bn-BD-NabanitaNeural
# TTS_EDGE_VOICE_EN=en-US-AriaNeural
# S35: pitch and volume, NEUTRAL by default. The voice is already neural — these are
# for a noisy waiting room or a hard-of-hearing patient, not a "sound human" dial.
# TTS_EDGE_PITCH=+0Hz
# TTS_EDGE_VOLUME=+0%
# Speaking rate offset, e.g. "-10%" (default), "+0%", "+15%".
# TTS_EDGE_RATE=-10%
# Give up on the network and fall back to espeak-ng after this many seconds.
# TTS_EDGE_TIMEOUT_S=12
# --- espeak provider ---
# Leave empty to find espeak-ng on PATH; set a full path if it is installed elsewhere.
# TTS_ESPEAK_PATH=
# espeak-ng voice per UI language. Try bn+dialect variants if the default is unclear.
# TTS_VOICE_BN=bn
# TTS_VOICE_EN=en-us
# Words per minute. espeak's own default (175) is too fast for an unwell patient.
# TTS_SPEED_WPM=140

# --- Patient identification (kiosk phone + OTP, ADR-0030 + P4-1 ADR-0045) ---
# OTP_CHANNEL picks how the verification code reaches the patient:
#   dev     = the code is printed to the SERVER LOG (no SMS) — development default.
#   textbee = real SMS through a TextBee.dev Android gateway (free, own SIM).
OTP_CHANNEL=dev
# The 000000 universal bypass works ONLY when OTP_CHANNEL=dev AND this is true.
# It can never work on a production channel, whatever this flag says.
OTP_DEV_BYPASS=true
DEV_OTP=000000
# Code lifetime / lockout / resend throttle (defaults shown; rarely need changing).
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# TextBee (only needed when OTP_CHANNEL=textbee): install the TextBee app on an
# Android phone with a BD SIM, register at https://textbee.dev, then paste:
# TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=
# TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# --- Persistence ---
# Full SQLAlchemy URL for the database. Leave BLANK to use the default local SQLite
# file (backend/prescreener.db). Schema changes are applied by Alembic migrations
# automatically at startup, so you never have to delete the DB.
# Example for Postgres later:  postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# Where generated .docx (and later PDF) files are written. Leave BLANK to use the
# default (backend/data/documents). Point this at any folder or mounted volume in
# deployment — nothing is hardcoded. (Legacy name DOCUMENTS_DIR is still accepted.)
DOCUMENT_OUTPUT_PATH=
